# Copy to .env and fill ngrok values.
# DB_PASSWORD / REDIS_PASSWORD are generated automatically by bootstrap.ps1.
DB_PASSWORD=change_me
REDIS_PASSWORD=change_me

# ngrok: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional reserved/static domain, e.g. siyu-erp.ngrok.app (no https://)
NGROK_DOMAIN=
