# Copy to .env and fill values.
# Existing MySQL/MariaDB and Redis can be reused by setting the real ports/credentials.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=change_me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# 可选：插件/上传/临时文件运行时目录。必须是纯 ASCII 路径。
# 留空时自动使用 E:\siyu-erp-runtime（没有 E 盘则用 C:\siyu-erp-runtime）。
RUNTIME_ROOT=

# ngrok: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional reserved/static domain, e.g. siyu-erp.ngrok.app (no https://)
NGROK_DOMAIN=
